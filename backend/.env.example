APP_NAME=HireFlow
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Public URL of the React SPA (used in emailed links).
FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# Errors go to storage/logs/errors.log (one line each, no stack traces).
LOG_STACK=errors
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local debugging: write every API request and its JSON answer to storage/logs/api-YYYY-MM-DD.log.
# Responses contain personal data, so keep this false in production.
API_LOG_ENABLED=true
API_LOG_MAX_BODY=4000

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hireflow
DB_USERNAME=hireflow
DB_PASSWORD=

# Sanctum SPA authentication. The SPA is served by Vite on :5173 and proxies /api and
# /sanctum to this app, so the browser sees a single origin (localhost:5173).
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@hireflow.test"
MAIL_FROM_NAME="${APP_NAME}"

# OpenAPI docs (l5-swagger): http://localhost:8000/api/documentation
L5_SWAGGER_CONST_HOST=http://localhost:8000
L5_SWAGGER_GENERATE_ALWAYS=true
